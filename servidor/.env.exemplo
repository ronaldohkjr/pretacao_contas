# Copie este arquivo para .env (no servidor) e preencha. O .env NUNCA vai para o GitHub.

# seu usuário do GitHub (em minúsculas), dono do repositório
GITHUB_USUARIO=seu-usuario-github

# endereço do sistema. Sem domínio próprio, use o IP público do servidor com sslip.io, ex.: 129-146-10-20.sslip.io
DOMINIO=129-146-10-20.sslip.io

# Rascunho no Outlook pela conta Microsoft (opcional; a TI registra o app no Microsoft Entra — ver PUBLICAR.md)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=organizations
